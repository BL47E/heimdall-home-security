#!/bin/bash
# Shell-owned SSH monitor and local investigation operations.
set -eu
umask 077
ROOT=$(cd "$(dirname "$0")/.." && pwd)
# Without arguments in an interactive terminal, open the terminal application.
# Noninteractive invocations keep plain help as the default command.
if [ $# -eq 0 ] && [ -t 0 ] && [ -t 1 ]; then
  set -- --console
fi
case "${1:-help}" in
  help | --help | -h)
    cat <<'HELP'
Heimdall — explainable local SSH monitoring

Usage: heimdall [OPTION | COMMAND]

  --help, -h, help            Show this guide (the noninteractive default)
  --version, version          Show the software version
  --console, tui              Open the terminal app (also the interactive default)
  dashboard [OPTIONS]         Serve the browser dashboard locally; see dashboard --help
  init                        Create private local state
  status                      Show monitor health and alert counts as JSON
  monitor start|stop|run       Control background monitoring, or run foreground
  alerts                      List alerts as JSON
  events                      List the latest observations as JSON
  inspect ID                  Show one alert and its evidence as JSON
  review ID / reopen ID       Update review status and preserve its history
  report ID                   Write a readable investigation to stdout
  config get                  Show current rule/retention settings as JSON
  config set JSON             Apply a validated JSON settings patch
  config history              Show recorded configuration changes as JSON
  ingest FILE|-               Process journal-shaped samples (synthetic mode)
  cleanup                     Apply configured retention to local records
  discord configure           Save a webhook through stdin
  discord configure-test      Save a test endpoint through stdin
  discord enable|disable      Turn optional delivery on or off
  discord status|flush        Check delivery status or send pending notices
  virustotal configure        Save an optional API key through stdin
  virustotal disable|status   Remove the key or show local setup status
  virustotal lookup ID        Look up and store an eligible journal alert's IP
  virustotal simulate ID N    Store a labelled vendor count on a fixture alert
  demo                        Run a labelled synthetic demo in separate state

Defaults: four failures from one IP within 300 seconds; 60-day retention.
State: HEIMDALL_DATA_DIR, or ~/.local/state/heimdall (XDG_STATE_HOME supported).
Requires Bash, jq and Python 3. Live monitoring also requires Ubuntu journalctl.
Example: heimdall config set '{"threshold":4,"window_seconds":300}'
Review changes do not change SSH access. Blocking remains planned.
Discord starts disabled; configure its private destination through stdin.
VirusTotal sends the eligible source IP only when you explicitly request a lookup.
See docs/runbook.md for dashboard login and Ubuntu setup.
HELP
    exit 0
    ;;
  version | --version)
    cat "$ROOT/VERSION"
    exit 0
    ;;
esac
DATA=${HEIMDALL_DATA_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/heimdall}
STATE=$DATA/state.json
err() {
  printf '%s\n' "$*" >&2
  exit 1
}
case "${1:-}" in
  --console | tui)
    [ "$#" = 1 ] || err 'Usage: heimdall --console'
    command -v python3 >/dev/null 2>&1 || err 'Python 3 is required for the terminal panel'
    exec python3 "$ROOT/lib/tui.py" "$ROOT/bin/heimdall" "$DATA"
    ;;
  dashboard)
    shift
    command -v python3 >/dev/null 2>&1 || err 'Python 3 is required for the dashboard'
    exec python3 "$ROOT/web/server.py" "$@"
    ;;
esac
command -v jq >/dev/null 2>&1 || err 'jq is required'
command -v python3 >/dev/null 2>&1 || err 'python3 is required for address validation'
if [ "${1:-}" = demo ]; then
  [ "$#" = 1 ] || err 'Usage: demo'
  exec /bin/bash "$ROOT/lib/demo.sh"
fi
[ ! -L "$DATA" ] || err 'State directory must not be a symbolic link'
mkdir -p "$DATA" || err 'Cannot create state directory'
chmod 700 "$DATA" || err 'Cannot secure state directory'
[ ! -L "$STATE" ] || err 'State file must not be a symbolic link'
trap 'exit 130' HUP INT TERM
validate() {
  jq -e 'type == "object" and (.config | type == "object") and (.events | type == "array") and (.alerts | type == "array")' "$STATE" >/dev/null 2>&1 || err 'State is corrupt; refusing to overwrite it'
}
save() {
  tmp=$(mktemp "$DATA/.state.XXXXXXXX") || err 'Cannot create temporary state'
  if ! cat >"$tmp" || ! jq -e . "$tmp" >/dev/null 2>&1; then
    rm -f "$tmp"
    err 'Cannot write valid state'
  fi
  chmod 600 "$tmp" || {
    rm -f "$tmp"
    err 'Cannot secure state'
  }
  mv -f "$tmp" "$STATE" || {
    rm -f "$tmp"
    err 'Cannot replace state'
  }
}
# Monitor lifecycle must never hold the state transaction lock while waiting.
if [ "${1:-}" = monitor ]; then
  if [ "${2:-}" = run ] && [ "${HEIMDALL_MONITOR_LOCK_PID:-}" != "$$" ]; then
    exec python3 "$ROOT/lib/lock.py" "$DATA/.monitor.lock" HEIMDALL_MONITOR_LOCK_PID 0 "$ROOT/bin/heimdall" "$@"
  fi
  shift
  . "$ROOT/lib/monitor.sh"
  monitor_command "$@"
  exit
fi
# Delivery serializes itself separately; never hold the state lock over HTTP.
if [ "${1:-}" = discord ]; then
  shift
  . "$ROOT/lib/discord.sh"
  discord_command "$@"
  exit
fi
# Serialize provider operations separately so SSH ingestion continues during a lookup.
if [ "${1:-}" = virustotal ]; then
  action=${2:-}
  case "$action:$#" in
    status:2|configure:2|disable:2|lookup:3|simulate:4) ;;
    *) err 'Usage: virustotal configure|disable|status|lookup ID|simulate ID COUNT' ;;
  esac
  if [ "$action" != status ] && [ "${HEIMDALL_VIRUSTOTAL_LOCK_PID:-}" != "$$" ]; then
    exec python3 "$ROOT/lib/lock.py" "$DATA/.virustotal.lock" HEIMDALL_VIRUSTOTAL_LOCK_PID 5 "$ROOT/bin/heimdall" "$@"
  fi
  case "$action" in
    lookup|simulate)
      [ -f "$STATE" ] || err 'Unknown alert ID'
      target=$(jq -ce --arg id "$3" '.mode as $mode | .alerts[] | select(.id == $id) | {mode:($mode // "live"),source_ip,provenance}' "$STATE") || err 'Unknown alert ID'
      result=$(printf '%s\n' "$target" | python3 "$ROOT/lib/virustotal.py" "$DATA" "$action" "${4:-}")
      "$ROOT/bin/heimdall" _virustotal_update "$3" <<<"$result"
      ;;
    status)
      provider_state=$(python3 "$ROOT/lib/virustotal.py" "$DATA" status)
      printf '%s\n' "$provider_state" | jq '{provider_state:.}'
      ;;
    *) python3 "$ROOT/lib/virustotal.py" "$DATA" "$action" ;;
  esac
  exit
fi
if [ "${HEIMDALL_TRANSACTION_LOCK_PID:-}" != "$$" ]; then
  exec python3 "$ROOT/lib/lock.py" "$DATA/.transaction.lock" HEIMDALL_TRANSACTION_LOCK_PID 5 "$ROOT/bin/heimdall" "$@"
fi
if [ ! -e "$STATE" ]; then
  printf '%s\n' '{"config":{"threshold":4,"window_seconds":300,"retention_days":60},"events":[],"alerts":[],"sources":{},"cursor":null,"mode":"live","config_history":[],"monitor":{"state":"stopped","pid":null,"source":"journalctl -u ssh","last_event_at":null,"last_error":null,"coverage":"unavailable"}}' | save
fi
validate
cmd=${1:-}
shift || :
case "$cmd" in
  _discord)
    . "$ROOT/lib/discord_state.sh"
    discord_state_command "$@"
    ;;
  _virustotal_update)
    [ "$#" = 1 ] && [ "${HEIMDALL_VIRUSTOTAL_LOCK_PID:-}" = "$PPID" ] || err 'Expected a VirusTotal result from the lookup operation'
    result=$(jq -e --arg id "$1" --slurpfile received /dev/stdin '
      $received[0] as $lookup | (.mode // "live") as $mode |
      if any(.alerts[]; .id == $id and {mode:$mode,source_ip,provenance} == $lookup.target) then
        .alerts |= map(if .id == $id then .reputation = $lookup.reputation |
          .severity = (if (.reputation.flags // 0) >= 10 then "HIGH" else "MEDIUM" end)
        else . end)
      else error("The alert changed or expired during the lookup") end
    ' "$STATE")
    printf '%s\n' "$result" | save
    jq --arg id "$1" '.alerts[] | select(.id == $id) | {id,source_ip,severity,reputation}' "$STATE"
    ;;
  init)
    [ "$#" = 0 ] || err 'Usage: init'
    jq '.config' "$STATE"
    ;;
  status)
    [ "$#" = 0 ] || err 'Usage: status'
    if [ "$(jq -r '.mode' "$STATE")" = fixture ]; then
      manager_info='{"manager":"standalone","applicable":false}'
    else
      manager_info=$(python3 "$ROOT/lib/service.py" "$ROOT" "$DATA" inspect)
    fi
    alive=false
    pid=$(jq -r '.monitor.pid // empty' "$STATE")
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && ps -p "$pid" -o command= | grep -F "$ROOT/bin/heimdall monitor run" >/dev/null; then alive=true; fi
    virustotal_status=$(python3 "$ROOT/lib/virustotal.py" "$DATA" status)
    jq -L "$ROOT/lib" --argjson now "$(date +%s)" --argjson service "$manager_info" --argjson alive "$alive" --argjson virustotal "$virustotal_status" 'include "notifications"; {monitor:((.monitor // {state:"stopped",pid:null,source:"journalctl -u ssh",last_event_at:null,last_error:null,coverage:"unavailable"}) | if $alive then . else .coverage="unavailable" | .pid=null | if .state=="running" then .state="error" | .last_error="Monitor process exited; coverage unavailable" else . end end | .manager=$service.manager | .service=$service | if $service.manager=="unavailable" then .state="error" | .coverage="unavailable" | .last_error=$service.error elif $service.manager=="systemd" and ($service.active_state!="active" or $service.main_pid!=.pid) then .coverage="unavailable" | .pid=null | .state=(if $service.active_state=="inactive" then "stopped" else "error" end) | .last_error=(if $service.active_state=="inactive" then null else "Monitor service is not active with the recorded process; inspect systemctl status heimdall-monitor.service" end) else . end),counts:{events:(.events|length),alerts:(.alerts|length),needs_review:([.alerts[]|select(.review_status == "needs_review")]|length)},providers:{discord:(discord_summary($now).provider_state),virustotal:$virustotal},discord:discord_summary($now),mode:(.mode // "live"),config:.config}' "$STATE"
    ;;
  alerts)
    [ "$#" = 0 ] || err 'Usage: alerts'
    jq '.alerts | sort_by(.last_seen) | reverse | map(del(.events))' "$STATE"
    ;;
  events)
    [ "$#" = 0 ] || err 'Usage: events'
    jq '.events | reverse | .[:200]' "$STATE"
    ;;
  config)
    sub=${1:-}
    shift || :
    case "$sub" in
      get)
        [ "$#" = 0 ] || err 'Usage: config get'
        jq '.config' "$STATE"
        ;;
      history)
        [ "$#" = 0 ] || err 'Usage: config history'
        jq '.config_history // []' "$STATE"
        ;;
      set)
        [ "$#" = 1 ] || err 'Usage: config set JSON'
        patch=$1
        jq -e -n --argjson p "$patch" --slurpfile policies "$ROOT/lib/config-policy.json" '$policies[0] as $bounds | $p | type == "object" and (keys - ($bounds | keys) | length == 0) and (all(to_entries[]; . as $entry | (.value|type) == "number" and (.value|floor) == .value and .value >= $bounds[$entry.key][0] and .value <= $bounds[$entry.key][1]))' >/dev/null 2>&1 || err 'Invalid configuration patch'
        result=$(jq --argjson p "$patch" --argjson now "$(date +%s)" '.config += $p | .config_history = ((.config_history // []) + [{timestamp:$now,patch:$p}])' "$STATE") || err 'Cannot update configuration'
        printf '%s\n' "$result" | save
        jq '.config' "$STATE"
        ;;
      *) err 'Usage: config get|history|set JSON' ;;
    esac
    ;;
  inspect | review | reopen | report)
    [ "$#" = 1 ] || err "Usage: $cmd ID"
    id=$1
    jq -e --arg id "$id" 'any(.alerts[]; .id == $id)' "$STATE" >/dev/null || err 'Unknown alert ID'
    if [ "$cmd" = review ] || [ "$cmd" = reopen ]; then
      review_status=needs_review
      [ "$cmd" != review ] || review_status=reviewed
      result=$(jq --arg id "$id" --arg status "$review_status" --argjson now "$(date +%s)" '.alerts |= map(if .id == $id then .review_status=$status | .review_history += [{timestamp:$now,status:$status,reason:"owner"}] else . end)' "$STATE")
      printf '%s\n' "$result" | save
    fi
    record=$(jq --arg id "$id" '. as $state | .alerts[] | select(.id == $id) | .events = [.event_ids[] as $eid | $state.events[] | select(.id == $eid)]' "$STATE")
    if [ "$cmd" = report ]; then
      printf '%s\n' "$record" | jq -r '
        "Heimdall investigation \(.id)\nSource: \(.source_ip)\nSeverity: \(.severity)\nReview: \(.review_status)\nProvenance: \(.provenance)\n\(.explanation)\n\(.recommendation)",
        (if .reputation then .reputation |
          "\nVirusTotal reputation: \(.label)\(if .provenance == "simulated" then " (simulated)" elif .from_cache then " (cached)" else "" end)\nChecked: \(.checked_at | todateiso8601)",
          (if .flags == null then .reason else "Flagging vendors (malicious or suspicious): \(.flags)" end),
          (if (.flags // 0) >= 10 then "Severity raised to HIGH because at least 10 vendors flagged the IP." else empty end)
        else "\nVirusTotal reputation: Unknown (no lookup recorded)" end),
        "\nEvidence:\n", (.events[] | "\(.timestamp // "unknown") | \(.username // "unknown") | \(.message)"),
        "\nReview history:", (.review_history[] | "\(.timestamp) | \(.status) | \(.reason)")'
    else printf '%s\n' "$record"; fi
    ;;
  ingest | _journal_ingest)
    [ "$#" = 1 ] || err 'Usage: ingest FILE|-'
    provenance=fixture
    if [ "$cmd" = _journal_ingest ]; then
      [ "${HEIMDALL_MONITOR_LOCK_PID:-}" = "$PPID" ] &&
        [ "$PPID" = "$(jq -r '.monitor.pid // empty' "$STATE")" ] || err 'Journal ingestion requires the active monitor'
      provenance=journal
    else
      pid=$(jq -r '.monitor.pid // empty' "$STATE")
      if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then err 'Stop live monitoring before fixture ingestion; use a separate data directory for demonstrations'; fi
      jq -e '.cursor == null and (any(.events[]; .provenance == "journal") | not)' "$STATE" >/dev/null || err 'Use a separate data directory for fixtures; live evidence already exists'
    fi
    input=$1
    [ "$input" = - ] || [ -r "$input" ] || err 'Input file is unreadable'
    batch=$(mktemp "$DATA/.batch.XXXXXXXX")
    parsed=$(mktemp "$DATA/.parsed.XXXXXXXX")
    malformed=0
    if [ "$input" = - ]; then cat >"$batch"; else cat "$input" >"$batch"; fi
    : >"$parsed"
    while IFS= read -r line || [ -n "$line" ]; do
      if [ ${#line} -gt 65536 ] || ! normalized=$(printf '%s\n' "$line" | jq -ce --arg provenance "$provenance" -f "$ROOT/lib/parse.jq" 2>/dev/null); then
        malformed=$((malformed + 1))
        continue
      fi
      printf '%s\n' "$normalized" >>"$parsed"
    done <"$batch"
    python3 "$ROOT/lib/normalize.py" <"$parsed" >"$batch"
    result=$(jq -L "$ROOT/lib" --slurpfile incoming "$batch" --argjson malformed "$malformed" --argjson now "$(date +%s)" -f "$ROOT/lib/rules.jq" "$STATE") || {
      rm -f "$batch" "$parsed"
      err 'Event processing failed'
    }
    result=$(printf '%s\n' "$result" | jq --arg mode "$provenance" '.mode = (if $mode == "fixture" then "fixture" else "live" end) | if $mode == "journal" then .monitor.last_event_at = ([.events[]|select(.provenance == "journal")|.timestamp // empty]|max // null) else . end')
    printf '%s\n' "$result" | save
    rm -f "$batch" "$parsed"
    jq '.stats' "$STATE"
    ;;
  _monitor_state)
    [ "$#" = 1 ] || err 'Missing monitor state'
    [ "${HEIMDALL_MONITOR_LOCK_PID:-}" = "$PPID" ] || err 'Monitor status updates require the active monitor'
    result=$(jq --argjson p "$1" '
      if .mode == "fixture" then error("Use a separate live data directory")
      else .monitor = ((.monitor // {}) + $p) end' "$STATE")
    printf '%s\n' "$result" | save
    ;;
  cleanup)
    [ "$#" = 0 ] || err 'Usage: cleanup'
    before=$(jq '.events|length' "$STATE")
    result=$(jq -L "$ROOT/lib" --argjson now "$(date +%s)" 'include "notifications"; retention_cleanup($now)' "$STATE")
    printf '%s\n' "$result" | save
    after=$(jq '.events|length' "$STATE")
    jq -n --argjson removed "$((before - after))" '{events_removed:$removed}'
    ;;
  *) err 'Usage: heimdall init|status|alerts|events|inspect|review|reopen|config|ingest|monitor|report|cleanup|discord|virustotal' ;;
esac
