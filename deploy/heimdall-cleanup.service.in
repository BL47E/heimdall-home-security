# Manual template only. Replace every @...@ token and review before installation.
# Use the monitor's owner, release and live state directory. No journal access needed.
# Schedule through heimdall-cleanup.timer; this unit never starts the monitor.
[Unit]
Description=Heimdall local record retention cleanup

[Service]
Type=oneshot
User=@OWNER@
Group=@GROUP@
WorkingDirectory=@REPO_DIR@
Environment=HEIMDALL_DATA_DIR=@DATA_DIR@
ExecStart=@REPO_DIR@/bin/heimdall cleanup
TimeoutStartSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@DATA_DIR@
